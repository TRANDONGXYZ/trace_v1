{
  "name": "trace-whiteboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-cloud.mjs",
    "dev:frontend": "vite --host 127.0.0.1",
    "dev:ollama": "vite --host 127.0.0.1 --mode ollama",
    "dev:worker": "wrangler dev --config worker/wrangler.jsonc --port 8787",
    "deploy": "wrangler deploy",
    "deploy:worker": "wrangler deploy",
    "check:worker": "wrangler deploy --dry-run",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/model.test.js tests/history.test.js tests/dev-launcher.test.js tests/layout-restoration.test.js tests/backup.test.js tests/clustering.test.js tests/progress.test.js tests/phase-analytics.test.js tests/consequence-chains.test.js tests/reaction-time.test.js tests/appearance-layout.test.js tests/cluster-explanations.test.js tests/local-chat.test.js tests/worker.test.js tests/cloud-client.test.js",
    "test:cloud": "node tests/cloud-live.mjs",
    "test:startup": "node tests/local-startup.mjs",
    "test:ollama": "node --test tests/ollama.test.js",
    "test:browser": "playwright test",
    "test:production": "playwright test --config playwright.cloud.config.js"
  },
  "dependencies": {
    "@xyflow/react": "^12.9.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "vite": "^6.4.1",
    "wrangler": "^4.158.0"
  }
}
