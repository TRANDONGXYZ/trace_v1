{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "trace-ai",
  "send_metrics": false,
  "account_id": "51878879655da64260dff719142aac04",
  "main": "index.js",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "ai": { "binding": "AI", "remote": true },
  "vars": { "PAGES_PROJECT_NAME": "trace-whiteboard", "AI_ENABLED": "true", "LOCAL_DEVELOPMENT": "false" },
  "ratelimits": [
    { "name": "CLIENT_RATE_LIMIT", "namespace_id": "170801", "simple": { "limit": 20, "period": 60 } },
    { "name": "SITE_RATE_LIMIT", "namespace_id": "170802", "simple": { "limit": 60, "period": 60 } }
  ],
  "env": {
    "development": {
      "vars": { "PAGES_PROJECT_NAME": "trace-whiteboard", "AI_ENABLED": "true", "LOCAL_DEVELOPMENT": "true" },
      "ai": { "binding": "AI", "remote": true },
      "ratelimits": [
        { "name": "CLIENT_RATE_LIMIT", "namespace_id": "170811", "simple": { "limit": 20, "period": 60 } },
        { "name": "SITE_RATE_LIMIT", "namespace_id": "170812", "simple": { "limit": 60, "period": 60 } }
      ]
    }
  }
}
