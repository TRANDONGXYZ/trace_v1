{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Local API development only; production uses the root wrangler.jsonc.
  "name": "trace",
  "send_metrics": false,
  "account_id": "51878879655da64260dff719142aac04",
  "main": "site.js",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "ai": { "binding": "AI", "remote": true },
  "vars": { "SITE_ORIGIN": "https://trace.trandongxzy.workers.dev", "AI_ENABLED": "true", "LOCAL_DEVELOPMENT": "true" },
  "ratelimits": [
    { "name": "CLIENT_RATE_LIMIT", "namespace_id": "170811", "simple": { "limit": 20, "period": 60 } },
    { "name": "SITE_RATE_LIMIT", "namespace_id": "170812", "simple": { "limit": 60, "period": 60 } }
  ]
}
